# REDCap API connection for the cleaned PILS project.
REDCAP_API_URL=https://your-redcap.example/api/
REDCAP_API_TOKEN=replace-with-your-redcap-api-token

# Keep false for local HTTP development. Set true only when served over HTTPS.
AUTH_COOKIE_SECURE=false

# Run node scripts/setup-notifications.mjs to generate a permanent key pair.
# Keep the private key server-side; back up the pair and do not rotate casually.
VAPID_SUBJECT=https://eli3a.ddns.net
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
