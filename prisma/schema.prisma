generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../data/pils.db"
}

model User {
  id                 String    @id @default(cuid())
  username           String    @unique
  name               String
  organization       String    @default("PILS")
  passwordHash       String
  role               String
  roles              String    @default("[]")
  requestedRole      String
  status             String    @default("PENDING")
  mustChangePassword Boolean   @default(false)
  approvedAt         DateTime?
  approvedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  notificationPreference NotificationPreference?
  pushSubscriptions PushSubscription[]
  sessions           Session[]
  redcapActivities   RedcapActivity[]

  @@index([status])
}

model RedcapActivity {
  id                  String   @id @default(cuid())
  userId              String
  actorName            String
  actorUsername        String
  workflow             String
  recordId             String
  staffName            String?
  serviceDate          String?
  instrumentInstances String
  submittedData        String
  createdAt            DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([recordId])
  @@index([workflow])
  @@index([userId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  event        String
  targetUserId String?
  details      String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

model ClinicQueueEntry {
  id                 String             @id @default(cuid())
  queueDate          String
  recordId           String?
  displayName        String
  firstName          String?
  lastName           String?
  nationalId         String?
  visitWorkflow      String?
  clinicPurposes     String             @default("[]")
  prepPurposes       String             @default("[]")
  alias              String?
  patientCode        String?
  phone              String?
  source             String             @default("WALK_IN")
  isNewClient        Boolean            @default(false)
  status             String             @default("EXPECTED")
  currentStation     String             @default("RECEPTION")
  queueNumber        Int?
  tasks              String             @default("[]")
  appointmentSources String             @default("[]")
  notes              String?
  checkedInAt        DateTime?
  readyAt            DateTime?
  completedAt        DateTime?
  noShow             Boolean            @default(false)
  noShowInstance     Int?
  createdById        String
  createdByName      String
  updatedById        String
  updatedByName      String
  version            Int                @default(1)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  events             ClinicQueueEvent[]

  @@index([queueDate, status])
  @@index([queueDate, queueNumber])
  @@unique([recordId, queueDate])
}

model ClinicQueueEvent {
  id           String           @id @default(cuid())
  queueEntryId String
  actorId      String
  actorName    String
  action       String
  details      String?
  createdAt    DateTime         @default(now())
  entry        ClinicQueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  @@index([queueEntryId, createdAt])
}

model NotificationPreference {
  userId          String   @id
  enabled         Boolean  @default(false)
  clinicArrivals  Boolean  @default(false)
  enabledAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id           String   @id @default(cuid())
  userId       String
  sessionId    String
  endpoint     String   @unique
  p256dh       String
  auth         String
  locale       String   @default("en")
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveries   PushDelivery[]

  @@index([userId])
}

model PushDelivery {
  id             String   @id @default(cuid())
  queueEntryId   String
  subscriptionId String
  state          String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  subscription   PushSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([queueEntryId, subscriptionId])
}
